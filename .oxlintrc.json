{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react", "jsx-a11y", "unicorn"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "no-empty-pattern": "off",
    "radix": "off",
    "@typescript-eslint/no-empty-interface": "off",
    "@typescript-eslint/ban-types": "off",
    "react/no-array-index-key": "off",
    "no-focused-tests": "warn",
    "eqeqeq": "warn",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "import/consistent-type-specifier-style": ["warn", "prefer-inline"],
    "@typescript-eslint/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports",
        "disallowTypeAnnotations": false
      }
    ],
    "@typescript-eslint/no-floating-promises": "off",
    "@typescript-eslint/no-unsafe-type-assertion": "off",
    "@typescript-eslint/no-unnecessary-type-arguments": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "node_modules/**",
    "**/e2e/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "packages/api/src/codex-protocol/**",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/sonamu.shared.ts",
    "**/sonamu.lock",
    "**/*.d.ts"
  ],
  "overrides": [
    {
      // Sonamu lints generated code from a temp file at the package root, where its relative
      // imports do not resolve; type-aware fixes there see `any` and drop required assertions.
      "files": ["**/.sonamu-oxlint-*.ts"],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off"
      }
    }
  ]
}
