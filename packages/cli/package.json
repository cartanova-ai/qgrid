{
  "name": "@cartanova/qgrid-cli",
  "version": "2.15.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/qgrid"
  },
  "bin": {
    "qgrid": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bundle",
    "postinstall.mjs",
    "skills",
    "README.ko.md"
  ],
  "type": "module",
  "scripts": {
    "bundle": "cd ../api && pnpm build && cd ../cli && pnpm run bundle:copy",
    "bundle:copy": "pnpm run check:bundle-dependencies && rm -rf bundle && mkdir -p bundle/public && touch bundle/.env && cp -r ../api/dist ./bundle/dist && cp -r ../api/web-dist ./bundle/web-dist && cp -r ../api/src ./bundle/src",
    "build": "tsdown",
    "check:bundle-dependencies": "node tooling/check-bundled-api-dependencies.mjs",
    "postinstall": "node postinstall.mjs",
    "prepack": "pnpm run test && pnpm run bundle",
    "test": "vitest run --dir src && node --test tooling/check-bundled-api-dependencies.node-test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/sso": "catalog:",
    "@logtape/logtape": "catalog:",
    "@logtape/pretty": "catalog:",
    "@oxc-project/runtime": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "commander": "^13.0.0",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "json-schema-to-zod": "^2.8.1",
    "knex": "catalog:",
    "pg": "catalog:",
    "pngjs": "^7.0.0",
    "sonamu": "0.13.0",
    "typescript": "catalog:",
    "ws": "8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "semver": "catalog:",
    "tsdown": "catalog:",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
