{
  "name": "qgrid-api",
  "version": "0.0.1",
  "description": "Sonamu API server",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "sonamu dev",
    "build": "NODE_ENV=production sonamu build",
    "start": "sonamu start",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run",
    "test:watch": "vitest watch --config vitest.unit.config.ts --standalone",
    "test:coverage": "pnpm test:unit --coverage && pnpm test:db --coverage",
    "sonamu": "sonamu"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^4.0.0",
    "@better-auth/passkey": "catalog:",
    "@better-auth/sso": "catalog:",
    "@logtape/logtape": "2.0.0",
    "@logtape/pretty": "2.0.0",
    "@oxc-project/runtime": "^0.79.1",
    "ai": "^6.0.1",
    "better-auth": "catalog:",
    "dotenv": "^16",
    "json-schema-to-zod": "^2.8.1",
    "knex": "^3.2.9",
    "pg": "^8.16.3",
    "pngjs": "^7.0.0",
    "sonamu": "^0.11.16",
    "ws": "8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@sonamu-kit/cli": "^0.1.0",
    "@types/node": "26.6.5",
    "@types/pg": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "fastify": "^4",
    "ioredis": "^5.8.2",
    "typescript": "7.1.0-dev.20260831.1",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  }
}
