{
  "name": "qgrid-api",
  "version": "0.0.1",
  "description": "Sonamu API server",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "sonamu dev",
    "build": "NODE_ENV=production sonamu build",
    "start": "sonamu start",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run",
    "test:watch": "vitest watch --config vitest.unit.config.ts --standalone",
    "test:coverage": "pnpm test:unit --coverage && pnpm test:db --coverage",
    "sonamu": "sonamu"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/sso": "catalog:",
    "@logtape/logtape": "catalog:",
    "@logtape/pretty": "catalog:",
    "@oxc-project/runtime": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "json-schema-to-zod": "^2.8.1",
    "knex": "catalog:",
    "pg": "catalog:",
    "pngjs": "^7.0.0",
    "sonamu": "^0.13.0",
    "ws": "8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@sonamu-kit/cli": "^0.3.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "^8.20.0",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
