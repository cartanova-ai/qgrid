{
  "id": "RequestLog",
  "table": "request_logs",
  "title": "RequestLog",
  "props": [
    {
      "name": "id",
      "type": "integer",
      "desc": "ID"
    },
    {
      "name": "created_at",
      "desc": "등록일시",
      "dbDefault": "CURRENT_TIMESTAMP",
      "type": "date"
    },
    {
      "name": "token_name",
      "toFilter": true,
      "desc": "토큰 이름",
      "type": "string",
      "length": 100,
      "nullable": true
    },
    {
      "name": "project_name",
      "toFilter": true,
      "desc": "프로젝트 이름",
      "type": "string",
      "length": 50,
      "nullable": true
    },
    {
      "name": "model_name",
      "toFilter": true,
      "desc": "모델 이름",
      "type": "string",
      "length": 255,
      "nullable": true
    },
    {
      "name": "requested_model_name",
      "desc": "요청 모델 이름 (fallback 전)",
      "type": "string",
      "length": 255,
      "nullable": true
    },
    {
      "name": "fallback_count",
      "type": "integer",
      "nullable": true,
      "desc": "모델 fallback 횟수"
    },
    {
      "name": "user_prompt",
      "type": "string",
      "nullable": true,
      "desc": "사용자 프롬프트"
    },
    {
      "name": "system_prompt",
      "type": "string",
      "nullable": true,
      "desc": "시스템 프롬프트"
    },
    {
      "name": "response",
      "desc": "llm 응답 전문",
      "type": "string",
      "dbDefault": "\"\""
    },
    {
      "name": "input_tokens",
      "type": "integer",
      "desc": "입력 토큰",
      "dbDefault": "0"
    },
    {
      "name": "output_tokens",
      "type": "integer",
      "desc": "출력 토큰",
      "dbDefault": "0"
    },
    {
      "name": "cache_read_tokens",
      "type": "integer",
      "desc": "캐시 읽기 토큰",
      "dbDefault": "0"
    },
    {
      "name": "cache_creation_tokens",
      "type": "integer",
      "desc": "캐시 생성 토큰",
      "dbDefault": "0"
    },
    {
      "name": "cache_creation_5m_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "5분 TTL 캐시 생성 토큰"
    },
    {
      "name": "cache_creation_1h_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "1시간 TTL 캐시 생성 토큰"
    },
    {
      "name": "duration_ms",
      "type": "integer",
      "desc": "응답 소요시간(ms)",
      "dbDefault": "0"
    },
    {
      "name": "ttft_ms",
      "type": "integer",
      "desc": "first gen TTFT(ms)",
      "dbDefault": "0"
    },
    {
      "name": "cost_usd",
      "type": "integer",
      "nullable": true,
      "desc": "API 비용"
    },
    {
      "name": "cost_source",
      "type": "string",
      "length": 20,
      "nullable": true,
      "desc": "비용 출처(provider/pricing_table/mixed)"
    },
    {
      "name": "image_cost_usd",
      "type": "integer",
      "nullable": true,
      "desc": "이미지 생성 비용"
    },
    {
      "name": "image_cost_method",
      "type": "string",
      "length": 100,
      "nullable": true,
      "desc": "이미지 비용 계산 방식"
    },
    {
      "name": "service_tier",
      "type": "string",
      "length": 20,
      "nullable": true,
      "desc": "Requested OpenAI service tier"
    },
    {
      "name": "effort",
      "type": "string",
      "length": 10,
      "nullable": true,
      "desc": "effort level"
    },
    {
      "name": "history",
      "type": "json",
      "id": "HistoryItems",
      "nullable": true,
      "desc": "inject_items 히스토리"
    },
    {
      "name": "input_images",
      "type": "json",
      "id": "InputImages",
      "nullable": true,
      "desc": "현재 user turn 입력 이미지"
    },
    {
      "name": "tools",
      "type": "json",
      "id": "ToolDefinitions",
      "nullable": true,
      "desc": "요청에 장착된 tool 정의 목록"
    },
    {
      "name": "json_schema",
      "type": "string",
      "nullable": true,
      "desc": "structured output 요청의 JSON Schema 원문 (detail 의 response 타입 표시용)"
    },
    {
      "name": "status",
      "type": "enum",
      "id": "RequestLogStatus",
      "desc": "실행 상태",
      "dbDefault": "\"succeeded\""
    },
    {
      "name": "error_message",
      "type": "string",
      "nullable": true,
      "desc": "에러 메시지"
    },
    {
      "name": "response_json_ok",
      "type": "boolean",
      "nullable": true,
      "desc": "structured(jsonSchema) 요청의 응답 JSON 파싱 성공 여부. 비structured 요청은 null"
    },
    {
      "name": "tool_call_count",
      "type": "integer",
      "desc": "tool call 횟수",
      "dbDefault": "0"
    },
    {
      "name": "is_image_generation",
      "type": "boolean",
      "desc": "이미지 생성 turn 여부 (quota 귀속용)",
      "dbDefault": "false"
    },
    {
      "name": "is_structured",
      "type": "boolean",
      "desc": "structured output(jsonSchema) 요청 여부 (목록 구분 표시용)",
      "dbDefault": "false"
    }
  ],
  "indexes": [
    {
      "type": "index",
      "name": "request_logs_token_name_index",
      "columns": [
        {
          "name": "token_name"
        }
      ],
      "using": "btree"
    },
    {
      "type": "index",
      "name": "request_logs_project_name_index",
      "columns": [
        {
          "name": "project_name"
        }
      ],
      "using": "btree"
    },
    {
      "type": "index",
      "name": "request_logs_project_name_cost_usd_index",
      "columns": [
        {
          "name": "project_name"
        },
        {
          "name": "cost_usd"
        }
      ],
      "using": "btree"
    },
    {
      "type": "index",
      "name": "request_logs_model_name_index",
      "columns": [
        {
          "name": "model_name"
        }
      ],
      "using": "btree"
    },
    {
      "type": "index",
      "name": "request_logs_created_at_index",
      "columns": [
        {
          "name": "created_at"
        }
      ],
      "using": "btree"
    }
  ],
  "subsets": {
    "A": [
      "id",
      "created_at",
      "token_name",
      "project_name",
      "model_name",
      "requested_model_name",
