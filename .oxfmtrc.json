{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": true,
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/node_modules",
    "**/e2e/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "packages/api/src/codex-protocol/**",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/sonamu.shared.ts",
    "**/sonamu.lock",
    "**/*.mdx",
    "**/*.md",
    "**/*.d.ts",
    "output/**",
    ".playwright-cli/**"
  ]
}
